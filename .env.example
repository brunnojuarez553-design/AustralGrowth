# =============================================================================
# AUSTRAL GROWTH OS — ENVIRONMENT VARIABLES
# Duplicar este archivo como .env.local para desarrollo
# =============================================================================

# SUPABASE (obtener en supabase.com > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DATABASE (obtener en Supabase > Settings > Database)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# OPENAI (solo servidor: IA Comercial, Director IA y Acquisition Coach)
OPENAI_API_KEY=sk-proj-...
OPENAI_ACQUISITION_MODEL=gpt-5-mini

# GROQ (alternativa más rápida y barata — recomendada)
GROQ_API_KEY=gsk_...

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-con-openssl-rand-base64-32

# CLOUDINARY (para assets de proyectos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# RESEND (para emails transaccionales)
RESEND_API_KEY=re_...

# CRON SECRET (para automatizaciones programadas en Vercel)
CRON_SECRET=genera-con-openssl-rand-base64-32
